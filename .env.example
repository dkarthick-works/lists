# Copy to backend/.env for local dev, or to .env here for docker compose.
# The app keeps its tables in the "lists" schema of this database. Under docker
# the host must be reachable from inside the container (not localhost).
DATABASE_URL=postgres://lists_app:password@localhost:5432/postgres?sslmode=disable
PORT=8082
GOAUTH_BASE_URL=https://sign.deeka.work
# The same JWT_SECRET the Goauth service signs with; this server verifies
# access tokens with it. Never commit the real value.
JWT_SECRET=

# --- Pages (experimental) ---
# Text with more words than this becomes a page: a short title plus the full text.
PAGE_WORD_THRESHOLD=20
# A new page is titled with this many of its opening words straight away...
PAGE_INITIAL_TITLE_WORDS=10
# ...then the generated title, of at most this many words, replaces it.
TITLE_MAX_WORDS=6
# Longest page text accepted, in characters.
PAGE_MAX_CHARS=20000
# OpenRouter writes the generated titles, in the background. Leave the key or
# model empty and pages simply keep their opening-words title.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=15s
