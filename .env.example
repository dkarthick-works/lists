# Used by docker compose. The app keeps its tables in the "lists" schema of this
# database; the host must be reachable from inside the container (not localhost).
DATABASE_URL=postgres://lists_app:password@host:5432/postgres?sslmode=disable
PORT=8082
GOAUTH_BASE_URL=https://sign.deeka.work
# The same JWT_SECRET the Goauth service signs with. Lets this server verify
# access tokens itself instead of calling Goauth. Never commit the real value.
JWT_SECRET=
